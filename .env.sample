DATABASE_URL=postgres://postgres:postgres@db/postgres
POSTGRES_PASSWORD=postgres
DJANGO_ALLOWED_HOSTS=*
TARGET=development
DEBUG=0
SECRET_KEY=change-me-to-a-secure-random-key
LOGFIRE_TOKEN=
SENTRY_DSN=
SENTRY_SEND_DEFAULT_PII=false
SENTRY_TRACES_SAMPLE_RATE=0.2

# LLM Configuration
GEMINI_API_KEY=
LLM_MODEL=google-gla:gemini-3.8-flash


# Production Security
DJANGO_CSRF_TRUSTED_ORIGINS=https://cacrespo.xyz,https://www.cacrespo.xyz
SECURE_SSL_REDIRECT=true

EMAIL_HOST=
EMAIL_PORT=
EMAIL_USE_TLS=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

